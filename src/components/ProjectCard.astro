---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { statusLabel, kindLabel } from '../lib/labels';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const d = project.data;
const href = url(`/research/${project.id}/`);
---

<article class="card project">
  <a class="figure" href={href} tabindex="-1" aria-hidden="true">
    {
      d.figure ? (
        <Image src={d.figure} alt="" width={720} />
      ) : (
        <div class="fallback">
          <span>{d.title}</span>
        </div>
      )
    }
  </a>
  <div class="body">
    <div class="meta">
      <span class="badge accent">{statusLabel[d.status]}</span>
      <span class="badge">{kindLabel[d.kind]}</span>
      <span class="year mono">{d.date.getUTCFullYear()}</span>
    </div>
    <h3><a href={href}>{d.title}</a></h3>
    <p class="tldr">{d.tldr}</p>
    {d.why && <p class="why"><span class="mono">Why it matters</span> {d.why}</p>}
    {
      d.methods.length > 0 && (
        <div class="methods">
          {d.methods.map((m) => (
            <span class="chip">{m}</span>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .project:hover {
    transform: translateY(-2px);
    border-color: var(--ink-3);
  }
  .figure {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fallback {
    height: 100%;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: repeating-linear-gradient(135deg, var(--surface-2) 0 10px, var(--bg) 10px 20px);
    font-family: var(--font-serif);
    color: var(--ink-3);
    text-align: center;
  }
  .body {
    padding: 1.1rem 1.25rem 1.3rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }
  .year {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .tldr {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .why {
    font-size: 0.88rem;
    color: var(--ink-2);
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
  }
  .why .mono {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .methods {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
