---
import type { CollectionEntry } from 'astro:content';
import { notebookKindLabel } from '../lib/labels';
import { url, formatDate } from '../lib/url';

interface Props {
  entries: CollectionEntry<'notebook'>[];
}
const { entries } = Astro.props;
---

<ul class="entries">
  {
    entries.map((e) => (
      <li>
        <a href={url(`/notebook/${e.id}/`)}>
          <div class="meta">
            <time class="mono" datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time>
            <span class={`badge kind-${e.data.kind}`}>{notebookKindLabel[e.data.kind]}</span>
          </div>
          <h3>{e.data.title}</h3>
          <p>{e.data.summary}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  a {
    display: block;
    padding: 1.1rem 0;
    color: inherit;
    text-decoration: none;
  }
  a:hover h3 {
    color: var(--accent);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }
  time {
    font-size: 0.78rem;
    color: var(--ink-3);
  }
  h3 {
    font-size: 1.2rem;
    margin: 0 0 0.25rem;
  }
  p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .kind-null-result {
    color: var(--mark);
  }
</style>
