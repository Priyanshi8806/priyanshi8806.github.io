---
import { buildGraph, layout, labelDy } from '../lib/researchGraph';

const graph = await buildGraph();
const FONT = 13;
const view = layout(graph, 1000, 520, FONT);

const neighbors: Record<string, string[]> = {};
for (const l of graph.links) {
  (neighbors[l.source] ??= []).push(l.target);
  (neighbors[l.target] ??= []).push(l.source);
}
---

<figure class="research-map card">
  <div class="legend" aria-hidden="true">
    <span><i class="sw question"></i> Research question</span>
    <span><i class="sw project"></i> Project</span>
    <span><i class="sw method"></i> Method</span>
    <span class="hint muted">Hover a node to trace its connections · click to open</span>
  </div>
  <div class="scroller">
    <svg
      class="map"
      viewBox={view.viewBox}
      role="img"
      aria-label="Map connecting research questions, projects, and methods"
      style={`--font:${FONT}px`}
      data-map
    >
      <g class="links">
        {view.links.map((l) => (
          <line
            x1={l.a.x}
            y1={l.a.y}
            x2={l.b.x}
            y2={l.b.y}
            data-a={l.source}
            data-b={l.target}
            class={l.b.type === 'method' ? 'to-method' : ''}
          />
        ))}
      </g>
      <g class="nodes">
        {view.nodes.map((n) => {
          const shape =
            n.type === 'question' ? (
              <circle r="13" />
            ) : n.type === 'project' ? (
              <rect x="-8" y="-8" width="16" height="16" rx="4" />
            ) : (
              <circle r="6" />
            );
          const text = (
            <text y={labelDy[n.type]} text-anchor="middle">
              {n.label}
            </text>
          );
          return (
            <g class={`node ${n.type}`} data-id={n.id} transform={`translate(${n.x},${n.y})`} tabindex={n.href ? undefined : 0}>
              {n.href ? (
                <a href={n.href}>
                  {shape}
                  {text}
                </a>
              ) : (
                <>
                  {shape}
                  {text}
                </>
              )}
            </g>
          );
        })}
      </g>
    </svg>
  </div>
  <script type="application/json" data-neighbors set:html={JSON.stringify(neighbors)} />
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('.research-map')) {
    const neighbors: Record<string, string[]> = JSON.parse(
      fig.querySelector('[data-neighbors]')!.textContent || '{}',
    );
    for (const svg of fig.querySelectorAll<SVGSVGElement>('[data-map]')) {
      const clear = () => {
        svg.classList.remove('focus');
        svg.querySelectorAll('.on').forEach((el) => el.classList.remove('on'));
      };
      const focus = (id: string) => {
        clear();
        const keep = new Set([id, ...(neighbors[id] ?? [])]);
        svg.classList.add('focus');
        svg.querySelectorAll<SVGElement>('.node').forEach((n) => {
          if (keep.has(n.dataset.id!)) n.classList.add('on');
        });
        svg.querySelectorAll<SVGElement>('line').forEach((l) => {
          if (l.dataset.a === id || l.dataset.b === id) l.classList.add('on');
        });
      };
      svg.querySelectorAll<SVGElement>('.node').forEach((n) => {
        n.addEventListener('pointerenter', () => focus(n.dataset.id!));
        n.addEventListener('focusin', () => focus(n.dataset.id!));
        n.addEventListener('pointerleave', clear);
        n.addEventListener('focusout', clear);
      });
    }
  }
</script>

<style>
  .research-map {
    margin: 0;
    padding: 1rem;
    --c-question: #2a78d6;
    --c-project: #eb6834;
    --c-method: #1baf7a;
  }
  :global(:root[data-theme='dark']) .research-map {
    --c-question: #3987e5;
    --c-project: #d95926;
    --c-method: #199e70;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .research-map {
      --c-question: #3987e5;
      --c-project: #d95926;
      --c-method: #199e70;
    }
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.82rem;
    color: var(--ink-2);
    padding: 0.25rem 0.5rem 0.75rem;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .legend .hint {
    margin-left: auto;
  }
  .sw {
    display: inline-block;
    width: 12px;
    height: 12px;
  }
  .sw.question {
    border-radius: 50%;
    background: var(--c-question);
  }
  .sw.project {
    border-radius: 3px;
    background: var(--c-project);
  }
  .sw.method {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-method);
  }

  .map {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* On phones, keep text legible and let the map scroll sideways inside the card. */
  @media (max-width: 700px) {
    .scroller {
      overflow-x: auto;
      margin: 0 -1rem;
      padding: 0 1rem;
    }
    .map {
      width: 720px;
      max-width: none;
    }
    .legend .hint {
      display: block;
      margin-left: 0;
    }
    .legend .hint::after {
      content: ' · scroll sideways →';
    }
  }

  line {
    stroke: var(--line);
    stroke-width: 1.5;
    transition: opacity 0.15s, stroke 0.15s;
  }
  line.to-method {
    stroke-dasharray: 3 4;
  }
  .node {
    cursor: pointer;
    transition: opacity 0.15s;
    outline: none;
  }
  .node circle,
  .node rect {
    stroke: var(--surface);
    stroke-width: 2;
  }
  .node.question circle {
    fill: var(--c-question);
  }
  .node.project rect {
    fill: var(--c-project);
  }
  .node.method circle {
    fill: var(--c-method);
  }
  .node text {
    font-family: var(--font-sans);
    font-size: var(--font);
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .node.question text {
    font-family: var(--font-serif);
    font-size: calc(var(--font) * 1.3);
    font-weight: 600;
    fill: var(--ink);
  }
  .node.method text {
    font-size: calc(var(--font) * 0.92);
    fill: var(--ink-3);
  }
  .focus .node:not(.on),
  .focus line:not(.on) {
    opacity: 0.15;
  }
  .focus line.on {
    stroke: var(--ink-3);
  }
  .node.on text {
    fill: var(--ink);
  }
</style>
