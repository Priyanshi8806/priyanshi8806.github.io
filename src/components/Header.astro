---
import Icon from './Icon.astro';
import { site, nav } from '../config';
import { url } from '../lib/url';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(url(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')}>
      <span class="mono-mark" aria-hidden="true">{site.initials}</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <Icon name="lucide:sun" class="sun" />
        <Icon name="lucide:moon" class="moon" />
      </button>
      <button class="icon-btn menu-btn" id="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
        <Icon name="lucide:menu" />
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const menuBtn = document.getElementById('menu-toggle');
  menuBtn?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    menuBtn.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    margin-right: auto;
  }
  .mono-mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 500 0.72rem/1 var(--font-mono);
    letter-spacing: 0.02em;
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9rem;
  }
  nav a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--surface-2);
  }
  .actions {
    display: flex;
    gap: 0.25rem;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
    font-size: 1.1rem;
  }
  .icon-btn:hover {
    border-color: var(--line);
    color: var(--ink);
  }
  .icon-btn :global(.moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-btn :global(.sun) {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-btn :global(.moon) {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-btn :global(.sun) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .icon-btn :global(.moon) {
      display: block;
    }
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 900px) {
    .menu-btn {
      display: grid;
    }
    nav {
      position: absolute;
      top: 60px;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      display: none;
    }
    :global(body.nav-open) nav {
      display: block;
    }
    nav ul {
      flex-direction: column;
      padding: 0.5rem var(--gutter) 1rem;
    }
    nav a {
      padding: 0.7rem 0.5rem;
      font-size: 1rem;
    }
  }
  @media (max-width: 420px) {
    .brand-name {
      font-size: 1rem;
    }
  }
</style>
