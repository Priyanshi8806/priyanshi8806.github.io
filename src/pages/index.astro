---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsList from '../components/NewsList.astro';
import NotebookList from '../components/NotebookList.astro';
import Icon from '../components/Icon.astro';
import portrait from '../portrait.png';
import { site } from '../config';
import { url } from '../lib/url';
import { stageLabel } from '../lib/labels';
import { getProjects, getNotebook, getExplainers, getAgenda } from '../lib/content';

const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
const notebook = (await getNotebook()).slice(0, 3);
const explainer = (await getExplainers())[0];
const agenda = await getAgenda();
---

<Base>
  <div class="container">
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">{site.status}</p>
        <h1>{site.question}</h1>
        <p class="lede">{site.intro}</p>
        <SocialLinks />
      </div>
      <figure class="portrait">
        <Image src={portrait} alt={`Portrait of ${site.name}`} width={480} loading="eager" />
        <figcaption>
          <strong>{site.name}</strong>
          <span>{site.role}</span>
          <span class="muted"><Icon name="lucide:map-pin" /> {site.location}</span>
        </figcaption>
      </figure>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Questions I want to answer</h2>
        <a href={url('/agenda/')}>Full research agenda →</a>
      </div>
      <ol class="questions">
        {
          agenda.map((q, i) => (
            <li>
              <a href={url(`/agenda/#${q.id}`)}>
                <span class="num mono">0{i + 1}</span>
                <span class="badge">{stageLabel[q.data.stage]}</span>
                <h3>{q.data.title}</h3>
                <p>{q.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Selected work</h2>
        <a href={url('/research/')}>All research & projects →</a>
      </div>
      <div class="grid featured">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>

    {
      explainer && (
        <section class="section">
          <a class="card explainer-teaser" href={url(`/explainers/${explainer.id}/`)}>
            <div>
              <p class="eyebrow">Interactive explainer</p>
              <h2>{explainer.data.title}</h2>
              <p>{explainer.data.summary}</p>
              <span class="btn primary">
                Try it <Icon name="lucide:arrow-right" />
              </span>
            </div>
            <svg class="whip" viewBox="0 0 400 160" aria-hidden="true">
              {[0, 1, 2, 3].map((tier) => {
                const amp = 6 + tier * tier * 9;
                const pts = Array.from({ length: 41 }, (_, i) => {
                  const x = i * 10;
                  const y = 80 + Math.sin(i * 0.55 + tier * 0.6) * amp * (0.6 + 0.4 * Math.sin(i * 0.21));
                  return `${x},${y.toFixed(1)}`;
                }).join(' ');
                return <polyline points={pts} class={`t${tier}`} />;
              })}
            </svg>
          </a>
        </section>
      )
    }

    <div class="two-col section">
      <section>
        <div class="section-head">
          <h2>News</h2>
        </div>
        <NewsList limit={5} />
      </section>
      <section>
        <div class="section-head">
          <h2>From the notebook</h2>
          <a href={url('/notebook/')}>All entries →</a>
        </div>
        <NotebookList entries={notebook} />
      </section>
    </div>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding-top: 1.5rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.12;
    margin-bottom: 1.25rem;
  }
  .hero h1::first-letter {
    color: var(--accent);
  }
  .lede {
    margin-bottom: 1.75rem;
  }
  .portrait {
    margin: 0;
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .portrait figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 0.85rem;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .portrait figcaption strong {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
  }
  .portrait figcaption span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .questions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .questions a {
    display: block;
    height: 100%;
    padding: 1.25rem 1.25rem 1.4rem;
    border-top: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 0 var(--radius) var(--radius);
    color: inherit;
    text-decoration: none;
    transition: background 0.15s;
  }
  .questions a:hover {
    background: var(--surface-2);
  }
  .questions .num {
    font-size: 0.8rem;
    color: var(--accent);
    margin-right: 0.5rem;
  }
  .questions h3 {
    font-size: 1.2rem;
    margin: 0.8rem 0 0.5rem;
  }
  .questions p {
    color: var(--ink-2);
    font-size: 0.92rem;
    margin: 0;
  }

  .explainer-teaser {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    color: inherit;
    text-decoration: none;
  }
  .explainer-teaser p {
    color: var(--ink-2);
  }
  .whip polyline {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .whip .t0 {
    stroke: #86b6ef;
  }
  .whip .t1 {
    stroke: #3987e5;
  }
  .whip .t2 {
    stroke: #1c5cab;
  }
  .whip .t3 {
    stroke: #0d366b;
  }
  :global(:root[data-theme='dark']) .whip .t3 {
    stroke: #cde2fb;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .whip .t3 {
      stroke: #cde2fb;
    }
  }

  .featured {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .portrait {
      order: -1;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .portrait :global(img) {
      width: 96px;
      border-radius: 50%;
      aspect-ratio: 1;
    }
    .portrait figcaption {
      margin: 0;
    }
    .questions,
    .two-col,
    .explainer-teaser {
      grid-template-columns: 1fr;
    }
  }
</style>
