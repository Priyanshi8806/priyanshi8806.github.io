---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getExplainers } from '../../lib/content';
import { url, formatDate } from '../../lib/url';

const explainers = await getExplainers();
---

<Base title="Explainers" description="Interactive explanations of the ideas behind my research.">
  <div class="container narrow">
    <header>
      <p class="eyebrow">Explainers</p>
      <h1>Ideas you can play with</h1>
      <p class="lede">
        Interactive, plain-language explanations of the mechanisms behind my research. No equations needed to
        get the intuition. The citations are at the bottom if you want them.
      </p>
    </header>

    <ul class="list">
      {
        explainers.map((e) => (
          <li>
            <a class="card item" href={url(`/explainers/${e.id}/`)}>
              <Icon name="lucide:flask-conical" size="1.6em" />
              <div>
                <h2>{e.data.title}</h2>
                <p>{e.data.summary}</p>
                <span class="mono muted">
                  {formatDate(e.data.date)}
                  {e.data.readingTime && ` · ${e.data.readingTime}`}
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 1rem;
  }
  .item {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  .item:hover {
    border-color: var(--accent);
  }
  .item :global(svg) {
    flex: none;
    color: var(--accent);
  }
  h2 {
    font-size: 1.4rem;
  }
  p {
    color: var(--ink-2);
  }
  .mono {
    font-size: 0.78rem;
  }
</style>
