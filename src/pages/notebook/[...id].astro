---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotebook } from '../../lib/content';
import { notebookKindLabel } from '../../lib/labels';
import { url, formatDate } from '../../lib/url';

export async function getStaticPaths() {
  const entries = await getNotebook();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const project = entry.data.project ? await getEntry(entry.data.project) : undefined;
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="container narrow">
    <a class="back" href={url('/notebook/')}>← Lab notebook</a>
    <div class="meta">
      <time class="mono" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      <span class="badge">{notebookKindLabel[entry.data.kind]}</span>
      {entry.data.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    {
      project && (
        <p class="project">
          Part of <a href={url(`/research/${project.id}/`)}>{project.data.title}</a>
        </p>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    font-size: 0.88rem;
    margin-bottom: 2rem;
    text-decoration: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  time {
    font-size: 0.8rem;
    color: var(--ink-3);
    margin-right: 0.25rem;
  }
  .project {
    font-size: 0.9rem;
    color: var(--ink-3);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 0.6rem 0;
  }
</style>
