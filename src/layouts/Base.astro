---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string; // absolute path or URL to an OG image
  wide?: boolean;
}

const { title, description = site.description, image = '/og-default.png' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — Research`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// `image` is either a /public path or an already-resolved asset URL from getImage().
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(base && image.startsWith(`${base}/`) ? image : url(image), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Notebook`} href={url('/notebook/rss.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />

    <!-- Apply saved theme before paint to avoid a flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    {
      import.meta.env.PROD && site.goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 100;
    background: var(--surface);
    padding: 0.5rem 1rem;
  }
</style>
